{
  "name": "happyfox-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["global_fetch_strictly_public"],

  "placement": {
    "mode": "smart"
  },

  // Workers Cache: puts Cloudflare's cache in front of this Worker.
  // Caching is opt-in per response via Cache-Control - only the home page and the
  // well-known OAuth metadata set one; every other response is sent as no-store
  // (see withCacheDefaults in src/index.ts).
  // cross_version_cache is left off so a new deployment starts with a cold cache.
  "cache": {
    "enabled": true
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },

  // KV namespace for OAuth credential storage (REQUIRED)
  // Setup: wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "bca2a23940a44b1f8e23939b1f71e5c8"
    }
  ],

  // Environment-specific configurations (optional)
  // The OAuth issuer and resource identifiers are derived from the request URL by the
  // OAuth library; there is nothing to configure here.
  "env": {
    "production": {
      "name": "happyfox-mcp-prod"
    },
    "development": {
      "name": "happyfox-mcp-dev"
    }
  }

  // Required secrets (set via: wrangler secret put <NAME>):
  //   MCP_SESSION_SECRET - Secret key for session token signing (32+ characters recommended)
  //   CREDENTIAL_ENCRYPTION_KEY - 32-byte base64 key for AES-256-GCM credential encryption
  //                               Generate with: openssl rand -base64 32
  //
  // Environment variables (set in Cloudflare dashboard or via wrangler secret):
  //   ALLOWED_ORIGINS - Comma-separated list of allowed CORS origins (default: localhost)
}
